{
  "name": "it-inventory-ticketing-backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "prod": "NODE_ENV=production node app.js",
    "init-db": "node scripts/apply_schema.js",
    "migrate-pg": "node scripts/migrate_to_postgres.js",
    "rollback-pg": "node scripts/rollback_postgres.js",
    "seed-admin": "node scripts/create_admin.js",
    "test-db": "node scripts/test-db-connection.js",
